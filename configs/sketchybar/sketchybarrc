#!/usr/bin/env bash
#
# sketchybar main config, shared by the OmniWM and AeroSpace modules
# (modules/sketchybar). Ported from the homenix waybar (Hyprland) setup.
#
#   left:   [apple menu]  focused window title
#   center: workspaces (AeroSpace; under OmniWM its own workspace bar sits here)
#   right:  tray  bluetooth  wifi  volume  cpu  battery  weather  clock

export CONFIG_DIR="$HOME/.config/sketchybar"
export PLUGIN_DIR="$CONFIG_DIR/plugins"

# Generated by modules/sketchybar from the nix options (SKETCHYBAR_WORKSPACES).
source "$CONFIG_DIR/options.sh"
source "$CONFIG_DIR/colors.sh"
source "$CONFIG_DIR/icons.sh"

# ── Bar ──────────────────────────────────────────────────────────────────
# Transparent bar; each item carries its own rounded "chip" background, the
# same look as the waybar item styling.
#
# NOTE: height is mirrored in modules/omniwm/settings.nix (sketchybarHeight) and
# modules/aerospace/default.nix (gaps.outer.top) to compute the top gap. Change
# it everywhere, or windows will overlap the bar.
sketchybar --bar \
  height=26 \
  position=top \
  padding_left=6 \
  padding_right=6 \
  color="$BAR_COLOR" \
  y_offset=0 \
  margin=0 \
  blur_radius=0 \
  topmost=off

# ── Global item defaults ─────────────────────────────────────────────────
sketchybar --default \
  updates=when_shown \
  icon.font="JetBrainsMono Nerd Font:Bold:13.0" \
  icon.color="$FG" \
  label.font="JetBrainsMono Nerd Font:Bold:12.0" \
  label.color="$FG" \
  background.color="$ITEM_BG" \
  background.corner_radius=6 \
  background.height=20 \
  padding_left=3 \
  padding_right=3 \
  icon.padding_left=8 \
  icon.padding_right=4 \
  label.padding_left=4 \
  label.padding_right=8

source "$CONFIG_DIR/items.sh"

sketchybar --update
